{
  "name": "cguard",
  "description": "Keeps secrets, stray documents and destructive commands out of a Claude Code session. Every blocked action comes with a safe alternative.",
  "version": "0.1.51",
  "author": { "name": "simon-init" },
  "homepage": "https://github.com/simon-init/cguard",
  "repository": "https://github.com/simon-init/cguard",
  "license": "MIT",
  "privacyPolicyUrl": "https://github.com/simon-init/cguard/blob/master/PRIVACY.md",
  "keywords": ["security", "secrets", "guardrails", "hooks", "git", "privacy"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/cguard/hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/cguard/hook.py\"",
            "timeout": 15,
            "statusMessage": "cguard"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/cguard/hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/cguard/hook.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/cguard/hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/cguard/hook.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
